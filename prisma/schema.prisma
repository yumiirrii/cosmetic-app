generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  cleanser
  toner
  serum
  cream
}

// Productテーブル
model Product {
  // id          Int      @id @default(autoincrement()) // ID
  // category    String                                 // カテゴリ
  id          String @id @default(cuid())            // ID
  category    Category                               // カテゴリ
  isNew       Boolean @default(false)                // 新作フラグ
  name        String                                 // 商品名
  price       Int                                    // 価格
  description String?                                // 説明
  imageUrl    String                                 // 商品画像
  createdAt   DateTime @default(now())               // 登録日時
  updatedAt   DateTime @updatedAt                    // 更新日時
}